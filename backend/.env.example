SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_new_client_id
SHOPIFY_CLIENT_SECRET=your_new_client_secret

# Legacy company workbooks, used only by the explicit one-time company settings
# import and the compatibility API. Native previews/exports use database settings.
# Optional locally when the original workbooks are in the server user's Downloads.
PI_TEMPLATE_USD=C:/company-templates/pi-usd.xlsm
PI_TEMPLATE_INR=C:/company-templates/pi-inr.xlsm

# Production security settings. Copy required values into backend/.env or the
# service environment; never commit real credentials.
AMT_HTTPS=true
REDIS_URL=redis://:replace-with-a-strong-password@127.0.0.1:6379/0
AMT_TRUSTED_PROXY_COUNT=number_of_trusted_proxies
AMT_SESSION_IDLE_MINUTES=no_of_minutes_you_want_to_keep_the_session_alive
AMT_SESSION_ABSOLUTE_HOURS=no_of_hours_you_want_to_keep_the_session_alive

# Use only for the first startup of a new empty database, then remove both.
AMT_BOOTSTRAP_ADMIN_USERNAME=replace-with-a-username
AMT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
