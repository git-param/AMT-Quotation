SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_new_client_id
SHOPIFY_CLIENT_SECRET=your_new_client_secret

# Legacy company workbooks, used only by the explicit one-time company settings
# import and the compatibility API. Native previews/exports use database settings.
# Optional locally when the original workbooks are in the server user's Downloads.
PI_TEMPLATE_USD=C:/company-templates/pi-usd.xlsm
PI_TEMPLATE_INR=C:/company-templates/pi-inr.xlsm
